<a
  href="{{#if href}}{{href}}{{else}}{{#if page}}{{page}}{{else}}#{{/if}}{{/if}}"
  class="link link__{{variant}}{{#if className}} {{className}}{{/if}}"
  {{#if page}}data-link="{{page}}"{{/if}}
  {{#if action}}data-action="{{action}}"{{/if}}
>
  <span>{{text}}</span>
  <span>{{#if icon}}{{> (lookup . "icon")}}{{/if}}</span>
</a>
