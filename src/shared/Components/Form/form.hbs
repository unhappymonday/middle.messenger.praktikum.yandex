<form class="form" id="{{formId}}">
  {{#each fields}}
    {{#Label text=label for=id}}
      {{Input
        type=type
        id=id
        name=id
        value=value
        ref=ref
        placeholder=placeholder
        disabled=disabled
        invalid=error
        variant="text"
      }}

      {{#if error}}
        <div class="form__error">{{error}}</div>
      {{/if}}
    {{/Label}}
  {{/each}}
</form>