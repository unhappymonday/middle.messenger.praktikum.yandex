<dialog class="modal">
  <div class="modal__content">
    <header class="modal__header">
      <h2 class="modal__title">{{title}}</h2>
    </header>
    <div class="modal__body">{{children}}</div>
    <div class="modal__alert" ref="alert" role="alert" {{#unless alert}}hidden{{/unless}}>{{alert}}</div>
    <footer class="modal__footer">
      {{Button type="submit" variant="filled" text=actionText formId=formId}}
            {{Button
        variant="contained"
        type="button"
        text="Закрыть"
        events=closeEvents
      }}
    </footer>
  </div>
</dialog>
