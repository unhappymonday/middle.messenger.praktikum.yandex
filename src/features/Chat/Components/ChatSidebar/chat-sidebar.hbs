<aside class="sidebar sidebar__chat">
  <div class="sidebar__header">
    <div class="header__actions">
      {{Button
        id="create-chat-button"
        variant="icon"
        icon="plus-icon"
        className="button_create-chat"
        onClick=onCreateChatClick
        type="button"
      }}
    {{Link
      variant="profile"
      icon="arrow-icon"
      href="/settings"
      text="Профиль"
      page="/settings"
      className="link__profile-sidebar"
    }}
    </div>

    {{Input
      variant="search"
      value=""
      placeholder="Поиск"
      className="input__search-sidebar"
    }}
  </div>

  <ul>
  {{#each chats}}
    <li
      class="sidebar__item{{#if isActive}} sidebar__item_active{{/if}}"
      data-id="{{id}}"
    >
      {{ChatCard
        id=id
        name=name
        avatar=avatar
        lastMessage=lastMessage
        time=time
        unreadCount=unreadCount
        isOwnMessage=isOwnMessage
        isActive=isActive
      }}
    </li>
  {{/each}}
</ul>
</aside>
